# Copiez ce fichier en .env.local et renseignez vos valeurs.

# URL publique du site (utilisée pour sitemap, Open Graph, données structurées)
NEXT_PUBLIC_SITE_URL=https://www.nexworks.agency

# Adresse e-mail de contact affichée sur le site (laisser vide pour ne rien afficher)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Envoi réel du formulaire de contact (via Resend : https://resend.com) ---
# Tant que ces trois variables ne sont pas renseignées, le formulaire fonctionne en MODE DÉMO :
# rien n'est transmis et le site l'indique clairement à l'utilisateur.
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO_EMAIL=
# Expéditeur (domaine vérifié chez Resend), ex : "NEXWORKS <contact@votre-domaine.fr>"
CONTACT_FROM_EMAIL=

# Réseaux sociaux (facultatif, laisser vide si inexistant) — utilisés dans le pied de page et le Schema.org
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Liens vers les sites de demonstration en ligne (facultatif). Quand ils sont renseignes, le bouton
# "Acceder a la demonstration" apparait sur la page du projet.
NEXT_PUBLIC_DEMO_SOLEA_URL=
NEXT_PUBLIC_DEMO_CALYRA_URL=

# Coordonnées optionnelles du site de démonstration AZUR PLOMBERIE
# (laisser vide = aucun téléphone / e-mail affiché, conforme au brief)
NEXT_PUBLIC_AZUR_PHONE=
NEXT_PUBLIC_AZUR_EMAIL=

# Coordonnees optionnelles du site de demonstration MAISON RIVIERA (laisser vide = rien d'affiche)
NEXT_PUBLIC_RIVIERA_PHONE=
NEXT_PUBLIC_RIVIERA_EMAIL=

# Coordonnees optionnelles du site de demonstration VOLT FITNESS CLUB (laisser vide = rien d'affiche)
NEXT_PUBLIC_VOLT_PHONE=
NEXT_PUBLIC_VOLT_EMAIL=

# --- Vérification des moteurs (facultatif si le domaine est vérifié par DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Mentions légales et données d'entreprise : seuls les champs renseignés sont affichés
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_CAPITAL=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_POSTAL_CODE=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_SIREN=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_LEGAL_PHONE=
